- name: lpm_alerts_conntrack
  rules:
  - alert: LPMConntrackUtilHigh_WARN
    expr: |
      lpm:conntrack_utilization{lpm_conntrack_criticality="high"} > 0.50
    for: 5m
    labels:
      severity: WARN
      category: conntrack
      lpm: high
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMConntrackUtilHigh
    annotations:
      summary: Verbindungstabelle auf {{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }} stark belegt
      description: 'Belegte Conntrack-Einträge: {{ $value | humanizePercentage }}. Alarmgrenze: über 50 %, mindestens 5 Minuten.'
      action: sysctl net.netfilter.nf_conntrack_count net.netfilter.nf_conntrack_max prüfen. Verbindungsquellen und Traffic-Anstieg ermitteln; Limits anhand RAM und benötigter Verbindungszahl bewerten.
      pending_for: 5m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMConntrackUtilHigh_ERROR
