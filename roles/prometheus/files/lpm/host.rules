---
groups:
- name: lpm_recording_rules
  interval: 30s
  rules:
  - record: lpm:system_uptime_seconds
    labels:
      platform: linux
    expr: |
      (max by (instance, hostname, host, system_name, tenant, environment, site) (
        time() - node_boot_time_seconds
      ))
      or on (instance, tenant, environment, site)
      (max by (instance, hostname, host, system_name, tenant, environment, site) (
        system_uptime
      ))
  - record: lpm:system_uptime_seconds
    labels:
      platform: windows
    expr: |
      max by (instance, hostname, host, system_name, tenant, environment, site) (time() - (windows_system_boot_time_timestamp or windows_system_boot_time_timestamp_seconds or windows_system_system_up_time))
  - record: lpm:cpu_utilization:avg15m
    labels:
      platform: linux
    expr: |
      (avg by (instance, hostname, host, system_name, lpm_cpu_criticality, tenant, environment, site) (
        100 * (1 - avg_over_time(rate(node_cpu_seconds_total{mode="idle"}[5m])[15m:]))
      ))
      or on (instance, tenant, environment, site)
      (avg by (instance, hostname, host, system_name, tenant, environment, site, lpm_cpu_criticality) (
        100 - avg_over_time(cpu_usage_idle{cpu="cpu-total"}[15m])
      ))
  - record: lpm:cpu_utilization:avg15m
    labels:
      platform: windows
    expr: |
      avg by (instance, hostname, host, system_name, lpm_cpu_criticality, tenant, environment, site) (
        100 - (rate(windows_cpu_time_total{mode="idle"}[15m]) * 100)
      )
  - record: lpm:mem_utilization:avg15m
    labels:
      platform: linux
    expr: |
      (avg by (instance, hostname, host, system_name, lpm_mem_criticality, tenant, environment, site) (
        avg_over_time(((1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100)[15m:])
      ))
      or on (instance, tenant, environment, site)
      (avg by (instance, hostname, host, system_name, tenant, environment, site, lpm_mem_criticality) (
        avg_over_time((100 * (1 - mem_available / (mem_total > 0)))[15m:])
      ))
  - record: lpm:mem_utilization:avg15m
    labels:
      platform: windows
    expr: |
      avg by (instance, hostname, host, system_name, lpm_mem_criticality, tenant, environment, site) (
        avg_over_time((100 - ((windows_memory_physical_free_bytes / windows_memory_physical_total_bytes) * 100))[15m:])
      )
      or
      avg by (instance, hostname, host, system_name, lpm_mem_criticality, tenant, environment, site) (
        avg_over_time((100 - ((windows_os_physical_memory_free_bytes / windows_cs_physical_memory_bytes) * 100))[15m:])
      )
  - record: lpm:memory_available_bytes:avg15m
    labels:
      platform: linux
    expr: |
      (avg by (instance, hostname, host, system_name, lpm_mem_criticality, tenant, environment, site) (
        avg_over_time(node_memory_MemAvailable_bytes[15m])
      ))
      or on (instance, tenant, environment, site)
      (avg by (instance, hostname, host, system_name, tenant, environment, site, lpm_mem_criticality) (
        avg_over_time(mem_available[15m])
      ))
  - record: lpm:memory_available_bytes:avg15m
    labels:
      platform: windows
    expr: |
      avg by (instance, hostname, host, system_name, lpm_mem_criticality, tenant, environment, site) (
        avg_over_time(windows_memory_physical_free_bytes[15m])
      )
      or
      avg by (instance, hostname, host, system_name, lpm_mem_criticality, tenant, environment, site) (
        avg_over_time(windows_os_physical_memory_free_bytes[15m])
      )
  - record: lpm:swap_utilization:avg15m
    expr: |
      (avg by (instance, hostname, host, system_name, lpm_mem_criticality, tenant, environment, site) (
        avg_over_time(((1 - (node_memory_SwapFree_bytes / node_memory_SwapTotal_bytes)) * 100)[15m:])
        and on (instance, hostname, host, system_name, lpm_mem_criticality, tenant, environment, site)
        node_memory_SwapTotal_bytes > 0
      ))
      or on (instance, tenant, environment, site)
      (avg by (instance, hostname, host, system_name, tenant, environment, site, lpm_mem_criticality) (
        avg_over_time((100 * (1 - swap_free / (swap_total > 0)))[15m:])
      ))
    labels:
      platform: linux
  - record: lpm:swap_io_pages:rate15m
    expr: |
      (sum by (instance, hostname, host, system_name, lpm_mem_criticality, tenant, environment, site) (
        rate(node_vmstat_pswpin[15m]) + rate(node_vmstat_pswpout[15m])
      ))
      or on (instance, tenant, environment, site)
      (sum by (instance, hostname, host, system_name, tenant, environment, site, lpm_mem_criticality) (
        rate(kernel_vmstat_pswpin[15m]) + rate(kernel_vmstat_pswpout[15m])
      ))
    labels:
      platform: linux
  - record: lpm:disk_used_percent:avg15m
    labels:
      platform: linux
    expr: |
      ((avg by (instance, hostname, host, system_name, path, device, fstype, lpm_dsk_criticality, tenant, environment, site) (
        label_replace(
          avg_over_time(((1 - (node_filesystem_avail_bytes{fstype!~"tmpfs|devtmpfs|proc|sysfs|cgroup2?|devpts|securityfs|pstore|autofs|mqueue|hugetlbfs|debugfs|tracefs|configfs|fusectl|binfmt_misc|efivarfs|fuse[.]lxcfs|nsfs|overlay|squashfs",mountpoint!~"^/(run|proc|sys|dev)($|/)"} / node_filesystem_size_bytes{fstype!~"tmpfs|devtmpfs|proc|sysfs|cgroup2?|devpts|securityfs|pstore|autofs|mqueue|hugetlbfs|debugfs|tracefs|configfs|fusectl|binfmt_misc|efivarfs|fuse[.]lxcfs|nsfs|overlay|squashfs",mountpoint!~"^/(run|proc|sys|dev)($|/)"})) * 100)[15m:]),
          "path",
          "$1",
          "mountpoint",
          "(.*)"
        )
      ))
      and on (tenant, environment, site, instance, hostname, host, system_name, device, path)
      label_replace((node_filesystem_size_bytes > 0), "path", "$1", "mountpoint", "(.*)"))
      or on (instance, tenant, environment, site, path)
      (avg by (instance, hostname, host, system_name, tenant, environment, site, path, device, fstype, lpm_dsk_criticality) (
        avg_over_time(disk_used_percent{fstype!~"tmpfs|devtmpfs|proc|sysfs|cgroup2?|devpts|securityfs|pstore|autofs|mqueue|hugetlbfs|debugfs|tracefs|configfs|fusectl|binfmt_misc|efivarfs|fuse[.]lxcfs|nsfs|overlay|squashfs",path!~"^/(run|proc|sys|dev)($|/)"}[15m]) and on (instance, tenant, environment, site, path, device) (disk_total > 0)
      ))
  - record: lpm:disk_used_percent:avg15m
    labels:
      platform: windows
    expr: |
      avg by (instance, hostname, host, system_name, path, device, lpm_dsk_criticality, tenant, environment, site) (
        label_replace(label_replace(
          avg_over_time((100 * (1 - windows_logical_disk_free_bytes{volume!~"HarddiskVolume.+"} / (windows_logical_disk_size_bytes{volume!~"HarddiskVolume.+"} > 0)))[15m:]),
          "path", "$1", "volume", "(.*)"), "device", "$1", "volume", "(.*)")
      )
  - record: lpm:disk_inodes_used_percent:avg15m
    expr: |
      ((avg by (instance, hostname, host, system_name, path, device, fstype, lpm_dsk_criticality, tenant, environment, site) (
        label_replace(
          avg_over_time(((1 - (node_filesystem_files_free{fstype!~"tmpfs|devtmpfs|proc|sysfs|cgroup2?|devpts|securityfs|pstore|autofs|mqueue|hugetlbfs|debugfs|tracefs|configfs|fusectl|binfmt_misc|efivarfs|fuse[.]lxcfs|nsfs|overlay|squashfs",mountpoint!~"^/(run|proc|sys|dev)($|/)"} / node_filesystem_files{fstype!~"tmpfs|devtmpfs|proc|sysfs|cgroup2?|devpts|securityfs|pstore|autofs|mqueue|hugetlbfs|debugfs|tracefs|configfs|fusectl|binfmt_misc|efivarfs|fuse[.]lxcfs|nsfs|overlay|squashfs",mountpoint!~"^/(run|proc|sys|dev)($|/)"})) * 100)[15m:]),
          "path",
          "$1",
          "mountpoint",
          "(.*)"
        )
      ))
      and on (tenant, environment, site, instance, hostname, host, system_name, device, path)
      label_replace((node_filesystem_files > 0), "path", "$1", "mountpoint", "(.*)"))
      or on (instance, tenant, environment, site, path)
      (avg by (instance, hostname, host, system_name, tenant, environment, site, path, device, fstype, lpm_dsk_criticality) (
        avg_over_time((100 * disk_inodes_used{fstype!~"tmpfs|devtmpfs|proc|sysfs|cgroup2?|devpts|securityfs|pstore|autofs|mqueue|hugetlbfs|debugfs|tracefs|configfs|fusectl|binfmt_misc|efivarfs|fuse[.]lxcfs|nsfs|overlay|squashfs",path!~"^/(run|proc|sys|dev)($|/)"} / (disk_inodes_total{fstype!~"tmpfs|devtmpfs|proc|sysfs|cgroup2?|devpts|securityfs|pstore|autofs|mqueue|hugetlbfs|debugfs|tracefs|configfs|fusectl|binfmt_misc|efivarfs|fuse[.]lxcfs|nsfs|overlay|squashfs",path!~"^/(run|proc|sys|dev)($|/)"} > 0))[15m:]) and on (instance, tenant, environment, site, path, device) (disk_inodes_total > 0)
      ))
    labels:
      platform: linux
  - record: lpm:diskio_utilization:avg15m
    labels:
      platform: linux
    expr: |
      (avg by (instance, hostname, host, system_name, name, lpm_io_criticality, tenant, environment, site) (
        label_replace(
          rate(node_disk_io_time_seconds_total{device!~"^(dm-|loop|ram|fd|sr).*"}[15m]),
          "name",
          "$1",
          "device",
          "(.*)"
        )
      ))
      or on (instance, tenant, environment, site, name)
      (avg by (instance, hostname, host, system_name, tenant, environment, site, name, lpm_io_criticality) (
        rate(diskio_io_time{name!~"^(dm-|loop|ram|fd|sr).*"}[15m]) / 1000
      ))
  - record: lpm:diskio_utilization:avg15m
    labels:
      platform: windows
    expr: |
      avg by (instance, hostname, host, system_name, name, lpm_io_criticality, tenant, environment, site) (
        label_replace(
          (1 - clamp_min(rate(windows_logical_disk_idle_seconds_total{volume!~"HarddiskVolume.+"}[15m]), 0)),
          "name",
          "$1",
          "volume",
          "(.*)"
        )
      )
  - record: lpm:diskio_await:avg15m
    labels:
      platform: linux
    expr: |
      (avg by (instance, hostname, host, system_name, name, lpm_io_criticality, tenant, environment, site) (
        label_replace(
          (
            rate(node_disk_read_time_seconds_total{device!~"^(dm-|loop|ram|fd|sr).*"}[15m])
            + rate(node_disk_write_time_seconds_total{device!~"^(dm-|loop|ram|fd|sr).*"}[15m])
          )
          /
          clamp_min(
            rate(node_disk_reads_completed_total{device!~"^(dm-|loop|ram|fd|sr).*"}[15m])
            + rate(node_disk_writes_completed_total{device!~"^(dm-|loop|ram|fd|sr).*"}[15m]),
            0.001
          ) * 1000,
          "name",
          "$1",
          "device",
          "(.*)"
        )
      ))
      or on (instance, tenant, environment, site, name)
      (avg by (instance, hostname, host, system_name, tenant, environment, site, name, lpm_io_criticality) (
        (rate(diskio_read_time{name!~"^(dm-|loop|ram|fd|sr).*"}[15m]) + rate(diskio_write_time{name!~"^(dm-|loop|ram|fd|sr).*"}[15m])) / clamp_min(rate(diskio_reads{name!~"^(dm-|loop|ram|fd|sr).*"}[15m]) + rate(diskio_writes{name!~"^(dm-|loop|ram|fd|sr).*"}[15m]), 0.001)
      ))
  - record: lpm:diskio_await:avg15m
    labels:
      platform: windows
    expr: |
      avg by (instance, hostname, host, system_name, name, lpm_io_criticality, tenant, environment, site) (
        label_replace(
          (
            (
              rate(windows_logical_disk_read_seconds_total{volume!~"HarddiskVolume.+"}[15m])
              +
              rate(windows_logical_disk_write_seconds_total{volume!~"HarddiskVolume.+"}[15m])
            )
            /
            clamp_min(
              rate(windows_logical_disk_reads_total{volume!~"HarddiskVolume.+"}[15m])
              +
              rate(windows_logical_disk_writes_total{volume!~"HarddiskVolume.+"}[15m]),
              0.001
            )
          ) * 1000,
          "name",
          "$1",
          "volume",
          "(.*)"
        )
      )
  - record: lpm:diskio_queue:avg15m
    labels:
      platform: linux
    expr: |
      (avg by (instance, hostname, host, system_name, name, lpm_io_criticality, tenant, environment, site) (
        label_replace(
          avg_over_time(node_disk_io_now{device!~"^(dm-|loop|ram|fd|sr).*"}[15m]),
          "name",
          "$1",
          "device",
          "(.*)"
        )
      ))
      or on (instance, tenant, environment, site, name)
      (avg by (instance, hostname, host, system_name, tenant, environment, site, name, lpm_io_criticality) (
        avg_over_time(diskio_iops_in_progress{name!~"^(dm-|loop|ram|fd|sr).*"}[15m])
      ))
  - record: lpm:diskio_queue:avg15m
    labels:
      platform: windows
    expr: |
      avg by (instance, hostname, host, system_name, name, lpm_io_criticality, tenant, environment, site) (
        label_replace(
          avg_over_time(windows_logical_disk_requests_queued{volume!~"HarddiskVolume.+"}[15m]),
          "name",
          "$1",
          "volume",
          "(.*)"
        )
      )
  - record: lpm:net_bytes_recv:rate5m
    expr: |
      (sum by (instance, hostname, host, system_name, interface, lpm_net_criticality, tenant, environment, site) (
        label_replace(
          rate(node_network_receive_bytes_total{device!="lo"}[5m]),
          "interface",
          "$1",
          "device",
          "(.*)"
        )
      ))
      or on (instance, tenant, environment, site, interface)
      (sum by (instance, hostname, host, system_name, tenant, environment, site, interface, lpm_net_criticality) (
        rate(net_bytes_recv{interface!="lo"}[5m])
      ))
    labels:
      platform: linux
  - record: lpm:net_bytes_sent:rate5m
    expr: |
      (sum by (instance, hostname, host, system_name, interface, lpm_net_criticality, tenant, environment, site) (
        label_replace(
          rate(node_network_transmit_bytes_total{device!="lo"}[5m]),
          "interface",
          "$1",
          "device",
          "(.*)"
        )
      ))
      or on (instance, tenant, environment, site, interface)
      (sum by (instance, hostname, host, system_name, tenant, environment, site, interface, lpm_net_criticality) (
        rate(net_bytes_sent{interface!="lo"}[5m])
      ))
    labels:
      platform: linux
  - record: lpm:net_err_in:rate5m
    labels:
      platform: linux
    expr: |
      (sum by (instance, hostname, host, system_name, interface, lpm_neterr_criticality, tenant, environment, site) (
        label_replace(
          rate(node_network_receive_errs_total{device!="lo"}[5m]),
          "interface",
          "$1",
          "device",
          "(.*)"
        )
      ))
      or on (instance, tenant, environment, site, interface)
      (sum by (instance, hostname, host, system_name, tenant, environment, site, interface, lpm_neterr_criticality) (
        rate(net_err_in{interface!="lo"}[5m])
      ))
  - record: lpm:net_err_in:rate5m
    labels:
      platform: windows
    expr: |
      sum by (instance, hostname, host, system_name, interface, lpm_neterr_criticality, tenant, environment, site) (
        label_replace(
          rate(windows_net_packets_received_errors_total[5m]),
          "interface",
          "$1",
          "nic",
          "(.*)"
        )
      )
  - record: lpm:net_err_out:rate5m
    labels:
      platform: linux
    expr: |
      (sum by (instance, hostname, host, system_name, interface, lpm_neterr_criticality, tenant, environment, site) (
        label_replace(
          rate(node_network_transmit_errs_total{device!="lo"}[5m]),
          "interface",
          "$1",
          "device",
          "(.*)"
        )
      ))
      or on (instance, tenant, environment, site, interface)
      (sum by (instance, hostname, host, system_name, tenant, environment, site, interface, lpm_neterr_criticality) (
        rate(net_err_out{interface!="lo"}[5m])
      ))
  - record: lpm:net_err_out:rate5m
    labels:
      platform: windows
    expr: |
      sum by (instance, hostname, host, system_name, interface, lpm_neterr_criticality, tenant, environment, site) (
        label_replace(
          rate(windows_net_packets_outbound_errors_total[5m]),
          "interface",
          "$1",
          "nic",
          "(.*)"
        )
      )
  - record: lpm:net_drop_in:rate5m
    labels:
      platform: linux
    expr: |
      (sum by (instance, hostname, host, system_name, interface, lpm_neterr_criticality, tenant, environment, site) (
        label_replace(
          rate(node_network_receive_drop_total{device!="lo"}[5m]),
          "interface",
          "$1",
          "device",
          "(.*)"
        )
      ))
      or on (instance, tenant, environment, site, interface)
      (sum by (instance, hostname, host, system_name, tenant, environment, site, interface, lpm_neterr_criticality) (
        rate(net_drop_in{interface!="lo"}[5m])
      ))
  - record: lpm:net_drop_in:ratio5m
    labels:
      platform: linux
    expr: |
      (sum by (instance, hostname, host, system_name, interface, lpm_neterr_criticality, tenant, environment, site) (
        label_replace(
          rate(node_network_receive_drop_total{device!="lo"}[5m]),
          "interface",
          "$1",
          "device",
          "(.*)"
        )
      )
      /
      clamp_min(
        sum by (instance, hostname, host, system_name, interface, lpm_neterr_criticality, tenant, environment, site) (
          label_replace(
            rate(node_network_receive_packets_total{device!="lo"}[5m]),
            "interface",
            "$1",
            "device",
            "(.*)"
          )
        ),
        1
      ))
      or on (instance, tenant, environment, site, interface)
      (sum by (instance, hostname, host, system_name, tenant, environment, site, interface, lpm_neterr_criticality) (
        rate(net_drop_in{interface!="lo"}[5m]) / clamp_min(rate(net_packets_recv{interface!="lo"}[5m]), 1)
      ))
  - record: lpm:net_drop_in:rate5m
    labels:
      platform: windows
    expr: |
      sum by (instance, hostname, host, system_name, interface, lpm_neterr_criticality, tenant, environment, site) (
        label_replace(
          rate(windows_net_packets_received_discarded_total[5m]),
          "interface",
          "$1",
          "nic",
          "(.*)"
        )
      )
  - record: lpm:net_drop_out:rate5m
    labels:
      platform: linux
    expr: |
      (sum by (instance, hostname, host, system_name, interface, lpm_neterr_criticality, tenant, environment, site) (
        label_replace(
          rate(node_network_transmit_drop_total{device!="lo"}[5m]),
          "interface",
          "$1",
          "device",
          "(.*)"
        )
      ))
      or on (instance, tenant, environment, site, interface)
      (sum by (instance, hostname, host, system_name, tenant, environment, site, interface, lpm_neterr_criticality) (
        rate(net_drop_out{interface!="lo"}[5m])
      ))
  - record: lpm:net_drop_out:rate5m
    labels:
      platform: windows
    expr: |
      sum by (instance, hostname, host, system_name, interface, lpm_neterr_criticality, tenant, environment, site) (
        label_replace(
          rate(windows_net_packets_outbound_discarded_total[5m]),
          "interface",
          "$1",
          "nic",
          "(.*)"
        )
      )
  - record: lpm:conntrack_utilization
    expr: |
      (max by (instance, hostname, host, system_name, lpm_conntrack_criticality, tenant, environment, site) (
        node_nf_conntrack_entries / (node_nf_conntrack_entries_limit > 0)
      ))
      or on (instance, tenant, environment, site)
      (max by (instance, hostname, host, system_name, tenant, environment, site, lpm_conntrack_criticality) (
        (conntrack_ip_conntrack_count or conntrack_nf_conntrack_count) / ((conntrack_ip_conntrack_max or conntrack_nf_conntrack_max) > 0)
      ))
    labels:
      platform: linux
  - record: lpm:conntrack_invalid:rate5m
    expr: |
      (sum by (instance, hostname, host, system_name, lpm_conntrack_criticality, tenant, environment, site) (
        rate(node_nf_conntrack_stat_invalid[5m])
      ))
      or on (instance, tenant, environment, site)
      (sum by (instance, hostname, host, system_name, tenant, environment, site, lpm_conntrack_criticality) (
        rate(conntrack_invalid{cpu="all"}[5m])
      ))
    labels:
      platform: linux
  - record: lpm:conntrack_drop:rate5m
    expr: |
      (sum by (instance, hostname, host, system_name, lpm_conntrack_criticality, tenant, environment, site) (
        rate(node_nf_conntrack_stat_drop[5m])
      ))
      or on (instance, tenant, environment, site)
      (sum by (instance, hostname, host, system_name, tenant, environment, site, lpm_conntrack_criticality) (
        rate(conntrack_drop{cpu="all"}[5m])
      ))
    labels:
      platform: linux
  - record: lpm:conntrack_early_drop:rate5m
    expr: |
      (sum by (instance, hostname, host, system_name, lpm_conntrack_criticality, tenant, environment, site) (
        rate(node_nf_conntrack_stat_early_drop[5m])
      ))
      or on (instance, tenant, environment, site)
      (sum by (instance, hostname, host, system_name, tenant, environment, site, lpm_conntrack_criticality) (
        rate(conntrack_early_drop{cpu="all"}[5m])
      ))
    labels:
      platform: linux
  - record: lpm:systemd_active_code
    expr: |
      max by (instance, hostname, host, system_name, tenant, environment, site, name, lpm_systemd_criticality) (1 - node_systemd_unit_state{state="active",lpm_service_expected="true"})
      or on (instance, tenant, environment, site, name)
      max by (instance, hostname, host, system_name, tenant, environment, site, name, lpm_systemd_criticality) (systemd_units_active_code{lpm_service_expected="true"})
    labels:
      platform: linux
  - record: lpm:systemd_load_code
    expr: |
      max by (instance, hostname, host, system_name, tenant, environment, site, name, lpm_systemd_criticality) (systemd_units_load_code{lpm_service_expected="true"})
    labels:
      platform: linux
  - record: lpm:systemd_sub_code
    expr: |
      max by (instance, hostname, host, system_name, tenant, environment, site, name, lpm_systemd_criticality) (systemd_units_sub_code{lpm_service_expected="true"})
    labels:
      platform: linux
  - record: lpm:systemd_active_code
    expr: |
      max by (instance, hostname, host, system_name, tenant, environment, site, name, lpm_systemd_criticality) (1 - windows_service_state{state="running",lpm_service_expected="true"})
    labels:
      platform: windows
  - record: lpm:portcheck_result_code
    expr: |
      max by (instance, hostname, host, system_name, tenant, environment, site, server, port, protocol, platform, target, lpm_portcheck_criticality) (
        label_join(net_response_result_code{monitoring_profile="lpm"}, "target", ":", "server", "port")
      )
      or on (instance, tenant, environment, site, target)
      max by (instance, hostname, host, system_name, tenant, environment, site, server, port, protocol, platform, target, lpm_portcheck_criticality) (
        (label_replace(1 - probe_success{monitoring_profile="lpm",probe_kind="port",target=""}, "target", "$1", "instance", "(.*)") or (1 - probe_success{monitoring_profile="lpm",probe_kind="port",target!=""}))
      )
  - record: lpm:portcheck_response_time:avg5m
    expr: |
      avg by (instance, hostname, host, system_name, tenant, environment, site, server, port, protocol, platform, target, lpm_portcheck_criticality) (
        label_join(avg_over_time(net_response_response_time{monitoring_profile="lpm"}[5m]), "target", ":", "server", "port")
      )
      or on (instance, tenant, environment, site, target)
      avg by (instance, hostname, host, system_name, tenant, environment, site, server, port, protocol, platform, target, lpm_portcheck_criticality) (
        (label_replace(avg_over_time(probe_duration_seconds{monitoring_profile="lpm",probe_kind="port",target=""}[5m]), "target", "$1", "instance", "(.*)") or avg_over_time(probe_duration_seconds{monitoring_profile="lpm",probe_kind="port",target!=""}[5m]))
      )
  - record: lpm:httpcheck_result_code
    expr: |
      max by (instance, hostname, host, system_name, tenant, environment, site, server, method, platform, target, lpm_portcheck_criticality) (
        label_replace(http_response_result_code{monitoring_profile="lpm"}, "target", "$1", "server", "(.*)")
      )
      or on (instance, tenant, environment, site, target)
      max by (instance, hostname, host, system_name, tenant, environment, site, server, method, platform, target, lpm_portcheck_criticality) (
        (label_replace(1 - probe_success{monitoring_profile="lpm",probe_kind="http",target=""}, "target", "$1", "instance", "(.*)") or (1 - probe_success{monitoring_profile="lpm",probe_kind="http",target!=""}))
      )
  - record: lpm:httpcheck_response_time:avg5m
    expr: |
      avg by (instance, hostname, host, system_name, tenant, environment, site, server, method, platform, target, lpm_portcheck_criticality) (
        label_replace(avg_over_time(http_response_response_time{monitoring_profile="lpm"}[5m]), "target", "$1", "server", "(.*)")
      )
      or on (instance, tenant, environment, site, target)
      avg by (instance, hostname, host, system_name, tenant, environment, site, server, method, platform, target, lpm_portcheck_criticality) (
        (label_replace(avg_over_time(probe_duration_seconds{monitoring_profile="lpm",probe_kind="http",target=""}[5m]), "target", "$1", "instance", "(.*)") or avg_over_time(probe_duration_seconds{monitoring_profile="lpm",probe_kind="http",target!=""}[5m]))
      )
- name: lpm_alerts_cpu
  rules:
  - alert: LPMCpuPressure_ERROR
    expr: |
      lpm:cpu_utilization:avg15m > 90
      and on (instance, tenant, environment, site)
      (
        rate(node_pressure_cpu_waiting_seconds_total[15m]) > 0.20
        or
        (
          avg_over_time(windows_system_processor_queue_length[15m])
          > on (instance, tenant, environment, site) group_left
          count by (instance, tenant, environment, site) (windows_cpu_time_total{mode="idle"})
        )
      )
      and on (instance, tenant, environment, site) lpm:system_uptime_seconds > 1800
    for: 30m
    keep_firing_for: 10m
    labels:
      severity: ERROR
      category: cpu
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMCpuPressure
    annotations:
      summary: CPU-Auslastung und Wartezeit auf {{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }} zu hoch
      description: '{{ if eq $labels.platform "windows" }}CPU-Auslastung (15-Minuten-Mittel): {{ $value | printf "%.1f" }} %. Alarmgrenze: über 90 %, mindestens 30 Minuten. Zusätzlich ist die Prozessorwarteschlange größer als die Anzahl der logischen CPUs.{{ else if eq $labels.platform "linux" }}CPU-Auslastung (15-Minuten-Mittel): {{ $value | printf "%.1f" }} %. Alarmgrenze: über 90 %, mindestens 30 Minuten. Zusätzlich wartet das System über 20 % der Zeit auf CPU-Zuteilung.{{ else }}CPU-Auslastung (15-Minuten-Mittel): {{ $value | printf "%.1f" }} %. Alarmgrenze: über 90 %, mindestens 30 Minuten; zusätzlich ist die plattformspezifische Wartezeitbedingung erfüllt. Betriebssystem anhand der Messreihe prüfen.{{ end }}'
      action: '{{ if eq $labels.platform "windows" }}Windows: Task-Manager nach CPU-Auslastung sortieren und Prozessorwarteschlange im Leistungsmonitor prüfen. Bei VMs zusätzlich die CPU-Auslastung des Hypervisors mit dem Alarmzeitraum abgleichen.{{ else if eq $labels.platform "linux" }}Linux: top; ps -eo pid,comm,pcpu --sort=-pcpu | head. Bei VMs zusätzlich die CPU-Auslastung des Hypervisors mit dem Alarmzeitraum abgleichen.{{ else }}Betriebssystem des überwachten Hosts prüfen. CPU-Verbraucher und Wartezeiten mit Benutzerlast, Batch-Jobs und Hypervisor abgleichen.{{ end }}'
      pending_for: 30m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMCpuHigh_WARN
    expr: |
      lpm:cpu_utilization:avg15m{lpm_cpu_criticality="high"} > 30
      and on (instance, tenant, environment, site) lpm:system_uptime_seconds > 600
    for: 15m
    labels:
      severity: WARN
      category: cpu
      lpm: high
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMCpuHigh
    annotations:
      summary: CPU-Auslastung erhöht auf {{ $labels.hostname }}
      description: CPU high/WARN überschritten ({{ $value | printf "%.2f" }}%).
      action: Ressourcenbedarf, laufende Prozesse und zeitgleiche Arbeitslast prüfen; die Kritikalitätsklasse mit dem vereinbarten Betriebsprofil abgleichen.
      pending_for: 15m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMCpuHigh_ERROR
    expr: |
      lpm:cpu_utilization:avg15m{lpm_cpu_criticality="high"} > 40
      and on (instance, tenant, environment, site) lpm:system_uptime_seconds > 600
    for: 15m
    labels:
      severity: ERROR
      category: cpu
      lpm: high
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMCpuHigh
    annotations:
      summary: CPU-Auslastung kritisch auf {{ $labels.hostname }}
      description: CPU high/ERROR überschritten ({{ $value | printf "%.2f" }}%).
      action: Ressourcenbedarf, laufende Prozesse und zeitgleiche Arbeitslast prüfen; die Kritikalitätsklasse mit dem vereinbarten Betriebsprofil abgleichen.
      pending_for: 15m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMCpuMid_WARN
    expr: |
      lpm:cpu_utilization:avg15m{lpm_cpu_criticality="mid"} > 70
      and on (instance, tenant, environment, site) lpm:system_uptime_seconds > 600
    for: 15m
    labels:
      severity: WARN
      category: cpu
      lpm: mid
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMCpuMid
    annotations:
      summary: CPU-Auslastung erhöht auf {{ $labels.hostname }}
      description: CPU mid/WARN überschritten ({{ $value | printf "%.2f" }}%).
      action: Ressourcenbedarf, laufende Prozesse und zeitgleiche Arbeitslast prüfen; die Kritikalitätsklasse mit dem vereinbarten Betriebsprofil abgleichen.
      pending_for: 15m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMCpuMid_ERROR
    expr: |
      lpm:cpu_utilization:avg15m{lpm_cpu_criticality="mid"} > 85
      and on (instance, tenant, environment, site) lpm:system_uptime_seconds > 600
    for: 15m
    labels:
      severity: ERROR
      category: cpu
      lpm: mid
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMCpuMid
    annotations:
      summary: CPU-Auslastung kritisch auf {{ $labels.hostname }}
      description: CPU mid/ERROR überschritten ({{ $value | printf "%.2f" }}%).
      action: Ressourcenbedarf, laufende Prozesse und zeitgleiche Arbeitslast prüfen; die Kritikalitätsklasse mit dem vereinbarten Betriebsprofil abgleichen.
      pending_for: 15m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMCpuLow_WARN
    expr: |
      lpm:cpu_utilization:avg15m{lpm_cpu_criticality="low"} > 85
      and on (instance, tenant, environment, site) lpm:system_uptime_seconds > 600
    for: 60m
    labels:
      severity: WARN
      category: cpu
      lpm: low
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMCpuLow
    annotations:
      summary: CPU-Auslastung erhöht auf {{ $labels.hostname }}
      description: CPU low/WARN überschritten ({{ $value | printf "%.2f" }}%).
      action: Ressourcenbedarf, laufende Prozesse und zeitgleiche Arbeitslast prüfen; die Kritikalitätsklasse mit dem vereinbarten Betriebsprofil abgleichen.
      pending_for: 60m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMCpuLow_ERROR
    expr: |
      lpm:cpu_utilization:avg15m{lpm_cpu_criticality="low"} > 95
      and on (instance, tenant, environment, site) lpm:system_uptime_seconds > 600
    for: 60m
    labels:
      severity: ERROR
      category: cpu
      lpm: low
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMCpuLow
    annotations:
      summary: CPU-Auslastung kritisch auf {{ $labels.hostname }}
      description: CPU low/ERROR überschritten ({{ $value | printf "%.2f" }}%).
      action: Ressourcenbedarf, laufende Prozesse und zeitgleiche Arbeitslast prüfen; die Kritikalitätsklasse mit dem vereinbarten Betriebsprofil abgleichen.
      pending_for: 60m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
- name: lpm_alerts_memory
  rules:
  - alert: LPMMemoryPressureLinux_ERROR
    expr: |
      lpm:mem_utilization:avg15m{platform="linux"} > 90
      and on (instance, tenant, environment, site)
      rate(node_pressure_memory_stalled_seconds_total[15m]) > 0.01
    for: 15m
    keep_firing_for: 10m
    labels:
      severity: ERROR
      category: memory
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMMemoryPressureLinux
    annotations:
      summary: Wenig RAM verfügbar; Prozesse warten auf Speicher auf {{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}
      description: 'RAM-Auslastung (15-Minuten-Mittel): {{ $value | printf "%.1f" }} %. Alarmgrenze: über 90 % für mindestens 15 Minuten; zusätzlich ist die plattformspezifische Speicher-Druckbedingung erfüllt.'
      action: 'Linux: free -h; ps -eo pid,comm,rss --sort=-rss | head; journalctl -k auf OOM-Ereignisse prüfen. Verbrauch mit Benutzerzahl und Batch-Jobs abgleichen.'
      pending_for: 15m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMMemoryPressureWindows_ERROR
    expr: |
      lpm:mem_utilization:avg15m{platform="windows"} > 90
      and on (instance, tenant, environment, site)
      (
        (windows_memory_committed_bytes / windows_memory_commit_limit) > 0.90
        or
        (
          rate(windows_memory_swap_pages_written_total[15m]) > 100
          and on (instance, tenant, environment, site) rate(windows_memory_swap_pages_read_total[15m]) > 100
        )
      )
    for: 15m
    keep_firing_for: 10m
    labels:
      severity: ERROR
      category: memory
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMMemoryPressureWindows
    annotations:
      summary: Wenig RAM verfügbar; Auslagerung oder zugesicherter Speicher erhöht auf {{ if $labels.host }}{{ $labels.host }}{{ else }}{{ $labels.instance }}{{ end }}
      description: 'RAM-Auslastung (15-Minuten-Mittel): {{ $value | printf "%.1f" }} %. Alarmgrenze: über 90 % für mindestens 15 Minuten; zusätzlich ist die plattformspezifische Speicher-Druckbedingung erfüllt.'
      action: 'Windows: Task-Manager nach zugesicherter Speichergröße sortieren; Ressourcenmonitor auf Auslagerung und Ereignisprotokoll auf ID 2004 prüfen. Verbrauch mit Benutzerzahl und Batch-Jobs abgleichen.'
      pending_for: 15m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMMemoryReserveCritical_ERROR
    expr: |
      lpm:memory_available_bytes:avg15m < 268435456
      and on (instance, tenant, environment, site) lpm:mem_utilization:avg15m > 97
    for: 10m
    keep_firing_for: 10m
    labels:
      severity: ERROR
      category: memory
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMMemoryReserveCritical
    annotations:
      summary: Weniger als 256 MiB RAM verfügbar auf {{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}
      description: 'Verfügbarer RAM (15-Minuten-Mittel): {{ $value | humanize1024 }}B. Alarmgrenze: unter 256 MiB und weniger als 3 % RAM verfügbar; mindestens 10 Minuten.'
      action: '{{ if eq $labels.platform "windows" }}Windows: Task-Manager nach zugesicherter Speichergröße sortieren; Ressourcenmonitor auf Auslagerung und Ereignisprotokoll auf ID 2004 prüfen. Verbrauch mit Benutzerzahl und Batch-Jobs abgleichen.{{ else if eq $labels.platform "linux" }}Linux: free -h; ps -eo pid,comm,rss --sort=-rss | head; journalctl -k auf OOM-Ereignisse prüfen. Verbrauch mit Benutzerzahl und Batch-Jobs abgleichen.{{ else }}Betriebssystem des überwachten Hosts prüfen. Verfügbaren RAM, zugesicherten Speicher und Auslagerung mit Benutzerzahl und Batch-Jobs abgleichen.{{ end }}'
      pending_for: 10m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMMemoryCommitCritical_ERROR
    expr: |
      100 * windows_memory_committed_bytes / windows_memory_commit_limit > 95
    for: 10m
    keep_firing_for: 10m
    labels:
      severity: ERROR
      category: memory
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMMemoryCommitCritical
      platform: windows
    annotations:
      summary: Zugesicherter Speicher auf {{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }} nahezu ausgeschöpft
      description: 'Genutzter Anteil des Windows-Zusicherungslimits: {{ $value | printf "%.1f" }} %. Alarmgrenze: über 95 %, mindestens 10 Minuten. Das Limit berücksichtigt RAM und Auslagerungsdatei; der Wert ist keine reine RAM-Belegung.'
      action: 'Windows: Task-Manager nach zugesicherter Speichergröße sortieren; Ressourcenmonitor auf Auslagerung und Ereignisprotokoll auf ID 2004 prüfen. Verbrauch mit Benutzerzahl und Batch-Jobs abgleichen.'
      pending_for: 10m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMMemoryOOMKilled_ERROR
    expr: |
      (increase(node_vmstat_oom_kill[5m]) > 0)
      or on (instance, tenant, environment, site)
      (increase(kernel_vmstat_oom_kill[5m]) > 0)
    keep_firing_for: 15m
    labels:
      severity: ERROR
      category: memory
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMMemoryOOMKilled
      platform: linux
    annotations:
      summary: Linux hat Prozesse wegen Speichermangel beendet auf {{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}
      description: 'In den letzten 5 Minuten wurden {{ $value | printf "%.0f" }} Prozessbeendigungen durch den Linux-OOM-Killer gezählt. Auslösung: mindestens ein Ereignis, ohne zusätzliche Verzögerung.'
      action: journalctl -k --since "15 minutes ago" auf "Out of memory" und "Killed process" prüfen. Beendeten Prozess, Speicherverbrauch und Anwendungslimits bestimmen; Dienstzustand und Neustartverhalten kontrollieren.
      pending_for: sofort
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMMemoryHigh_WARN
    expr: |
      lpm:mem_utilization:avg15m{lpm_mem_criticality="high"} > 60
    for: 15m
    labels:
      severity: WARN
      category: memory
      lpm: high
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMMemoryHigh
    annotations:
      summary: RAM-Auslastung erhöht auf {{ $labels.hostname }}
      description: RAM high/WARN überschritten ({{ $value | printf "%.2f" }}%).
      action: Verfügbare Speicherreserve, Prozessspeicher und anwendungsspezifische Grenzwerte prüfen; Cache allein nicht als Speicherdruck bewerten.
      pending_for: 15m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMMemoryHigh_ERROR
    expr: |
      lpm:mem_utilization:avg15m{lpm_mem_criticality="high"} > 75
    for: 15m
    labels:
      severity: ERROR
      category: memory
      lpm: high
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMMemoryHigh
    annotations:
      summary: RAM-Auslastung kritisch auf {{ $labels.hostname }}
      description: RAM high/ERROR überschritten ({{ $value | printf "%.2f" }}%).
      action: Verfügbare Speicherreserve, Prozessspeicher und anwendungsspezifische Grenzwerte prüfen; Cache allein nicht als Speicherdruck bewerten.
      pending_for: 15m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMMemoryMid_WARN
    expr: |
      lpm:mem_utilization:avg15m{lpm_mem_criticality="mid"} > 80
    for: 15m
    labels:
      severity: WARN
      category: memory
      lpm: mid
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMMemoryMid
    annotations:
      summary: RAM-Auslastung erhöht auf {{ $labels.hostname }}
      description: RAM mid/WARN überschritten ({{ $value | printf "%.2f" }}%).
      action: Verfügbare Speicherreserve, Prozessspeicher und anwendungsspezifische Grenzwerte prüfen; Cache allein nicht als Speicherdruck bewerten.
      pending_for: 15m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMMemoryMid_ERROR
    expr: |
      lpm:mem_utilization:avg15m{lpm_mem_criticality="mid"} > 90
    for: 15m
    labels:
      severity: ERROR
      category: memory
      lpm: mid
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMMemoryMid
    annotations:
      summary: RAM-Auslastung kritisch auf {{ $labels.hostname }}
      description: RAM mid/ERROR überschritten ({{ $value | printf "%.2f" }}%).
      action: Verfügbare Speicherreserve, Prozessspeicher und anwendungsspezifische Grenzwerte prüfen; Cache allein nicht als Speicherdruck bewerten.
      pending_for: 15m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMMemoryLow_WARN
    expr: |
      lpm:mem_utilization:avg15m{lpm_mem_criticality="low"} > 90
    for: 60m
    labels:
      severity: WARN
      category: memory
      lpm: low
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMMemoryLow
    annotations:
      summary: RAM-Auslastung erhöht auf {{ $labels.hostname }}
      description: RAM low/WARN überschritten ({{ $value | printf "%.2f" }}%).
      action: Verfügbare Speicherreserve, Prozessspeicher und anwendungsspezifische Grenzwerte prüfen; Cache allein nicht als Speicherdruck bewerten.
      pending_for: 60m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMMemoryLow_ERROR
    expr: |
      lpm:mem_utilization:avg15m{lpm_mem_criticality="low"} > 95
    for: 60m
    labels:
      severity: ERROR
      category: memory
      lpm: low
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMMemoryLow
    annotations:
      summary: RAM-Auslastung kritisch auf {{ $labels.hostname }}
      description: RAM low/ERROR überschritten ({{ $value | printf "%.2f" }}%).
      action: Verfügbare Speicherreserve, Prozessspeicher und anwendungsspezifische Grenzwerte prüfen; Cache allein nicht als Speicherdruck bewerten.
      pending_for: 60m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMSwapUsage
    expr: |
      lpm:swap_utilization:avg15m > 80
    for: 60m
    labels:
      severity: WARN
      category: memory
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMSwapUsage
    annotations:
      summary: Swap-Auslastung erhöht auf {{ $labels.hostname }}
      description: Swap-Auslastung liegt seit 60m über 80% (aktuell {{ $value | printf "%.2f" }}%).
      action: Verfügbare Speicherreserve, Prozessspeicher und anwendungsspezifische Grenzwerte prüfen; Cache allein nicht als Speicherdruck bewerten.
      pending_for: 60m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
- name: lpm_alerts_disk
  rules:
  - alert: LPMDiskUsageHigh_WARN
    expr: |
      lpm:disk_used_percent:avg15m{lpm_dsk_criticality="high"} > 70
    for: 15m
    labels:
      severity: WARN
      category: disk
      lpm: high
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMDiskUsageHigh
    annotations:
      summary: Wenig freier Speicher auf {{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }} – {{ $labels.path }}
      description: 'Belegt (15-Minuten-Mittel): {{ $value | printf "%.1f" }} %. Alarmgrenze: über 70 % belegt, mindestens 15 Minuten.'
      action: "{{ if eq $labels.platform \"windows\" }}Windows: Get-Volume -FilePath '{{ $labels.path }}\\' | Format-List DriveLetter,FileSystemLabel,Size,SizeRemaining,HealthStatus. Größte Datenbestände und Aufbewahrung für {{ $labels.path }} prüfen; bei weiter benötigten Daten Volume erweitern.{{ else if eq $labels.platform \"linux\" }}Linux: df -h \"{{ $labels.path }}\"; sudo du -xhd1 \"{{ $labels.path }}\" | sort -h. Größte Datenbestände und Aufbewahrung prüfen; bei weiter benötigten Daten Volume erweitern.{{ else }}Betriebssystem des überwachten Hosts prüfen. Freien Speicher, größte Datenbestände und Aufbewahrung für {{ $labels.path }} kontrollieren; bei weiter benötigten Daten Volume erweitern.{{ end }}"
      pending_for: 15m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
  - alert: LPMDiskUsageHigh_ERROR
    expr: |
      lpm:disk_used_percent:avg15m{lpm_dsk_criticality="high"} > 85
