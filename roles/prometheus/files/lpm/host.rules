      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMHttpcheckLow
    annotations:
      summary: HTTP-Healthcheck fehlgeschlagen auf {{ $labels.hostname }}
      description: Das konfigurierte Ziel {{ $labels.target }} liefert einen Fehlerstatus.
      action: Das konfigurierte HTTP-Ziel {{ $labels.target }}, Antwortstatus und Anwendungsabhängigkeiten prüfen.
      pending_for: 2m
      resolved_action: Die Alarmbedingung ist nicht mehr erfüllt. Aktuelle Messwerte und den betroffenen Dienst prüfen; eine vollständige Anwendungsprüfung wird durch diese Entwarnung nicht bestätigt.
