- name: lpm_alerts_io
  rules:
  - alert: LPMDiskAwaitHigh_WARN
    expr: 'lpm:diskio_await:avg15m{lpm_io_criticality="high"} > 10

      and on (instance, tenant, environment, site) lpm:system_uptime_seconds > 600

      '
    for: 15m
    labels:
      severity: WARN
      category: io
      lpm: high
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance
        }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMDiskAwaitHigh
    annotations:
      summary: "Datentr\xE4gerzugriffe auf {{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname\
        \ }}{{ else }}{{ $labels.instance }}{{ end }} dauern zu lange \u2013 {{ $labels.name }}"
      description: "Durchschnittliche Dauer abgeschlossener Lese-/Schreibzugriffe (15-Minuten-Mittel): {{ $value | printf\
        \ \"%.1f\" }} ms. Alarmgrenze: \xFCber 10 ms, mindestens 15 Minuten. Ger\xE4t: {{ $labels.name }}."
      action: "{{ if eq $labels.platform \"windows\" }}Windows: Ressourcenmonitor unter Datentr\xE4ger auf Antwortzeit und\
        \ verursachende Prozesse pr\xFCfen. Bei VMs Gastwerte mit Hypervisor und Storage abgleichen.{{ else if eq $labels.platform\
        \ \"linux\" }}Linux: iostat -xz 1 5; Lese-/Schreiblast und wartende Zugriffe dem Ger\xE4t zuordnen. Bei VMs Gastwerte\
        \ mit Hypervisor und Storage abgleichen.{{ else }}Betriebssystem des \xFCberwachten Hosts pr\xFCfen. Datentr\xE4ger-Antwortzeiten\
        \ und verursachende Prozesse mit Hypervisor und Storage abgleichen.{{ end }}"
      pending_for: 15m
      resolved_action: "Die Alarmbedingung ist nicht mehr erf\xFCllt. Aktuelle Messwerte und den betroffenen Dienst pr\xFC\
        fen; eine vollst\xE4ndige Anwendungspr\xFCfung wird durch diese Entwarnung nicht best\xE4tigt."
  - alert: LPMDiskAwaitHigh_ERROR
    expr: 'lpm:diskio_await:avg15m{lpm_io_criticality="high"} > 25

      and on (instance, tenant, environment, site) lpm:system_uptime_seconds > 600

      '
    for: 15m
    labels:
      severity: ERROR
      category: io
      lpm: high
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance
        }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMDiskAwaitHigh
    annotations:
      summary: "Datentr\xE4gerzugriffe auf {{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname\
        \ }}{{ else }}{{ $labels.instance }}{{ end }} dauern zu lange \u2013 {{ $labels.name }}"
      description: "Durchschnittliche Dauer abgeschlossener Lese-/Schreibzugriffe (15-Minuten-Mittel): {{ $value | printf\
        \ \"%.1f\" }} ms. Alarmgrenze: \xFCber 25 ms, mindestens 15 Minuten. Ger\xE4t: {{ $labels.name }}."
      action: "{{ if eq $labels.platform \"windows\" }}Windows: Ressourcenmonitor unter Datentr\xE4ger auf Antwortzeit und\
        \ verursachende Prozesse pr\xFCfen. Bei VMs Gastwerte mit Hypervisor und Storage abgleichen.{{ else if eq $labels.platform\
        \ \"linux\" }}Linux: iostat -xz 1 5; Lese-/Schreiblast und wartende Zugriffe dem Ger\xE4t zuordnen. Bei VMs Gastwerte\
        \ mit Hypervisor und Storage abgleichen.{{ else }}Betriebssystem des \xFCberwachten Hosts pr\xFCfen. Datentr\xE4ger-Antwortzeiten\
        \ und verursachende Prozesse mit Hypervisor und Storage abgleichen.{{ end }}"
      pending_for: 15m
      resolved_action: "Die Alarmbedingung ist nicht mehr erf\xFCllt. Aktuelle Messwerte und den betroffenen Dienst pr\xFC\
        fen; eine vollst\xE4ndige Anwendungspr\xFCfung wird durch diese Entwarnung nicht best\xE4tigt."
  - alert: LPMDiskQueueHigh_ERROR
    expr: 'lpm:diskio_queue:avg15m{lpm_io_criticality="high"} > 5

      and on (instance, tenant, environment, site) lpm:system_uptime_seconds > 600

      '
    for: 15m
    labels:
      severity: ERROR
      category: io
      lpm: high
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance
        }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMDiskQueueHigh
    annotations:
      summary: "Viele wartende Datentr\xE4gerzugriffe auf {{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname\
        \ }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }} \u2013 {{ $labels.name }}"
      description: "Durchschnittlich wartende/aktive Datentr\xE4gerzugriffe (15-Minuten-Mittel): {{ $value | printf \"%.1f\"\
        \ }}. Alarmgrenze: \xFCber 5, mindestens 15 Minuten. Ger\xE4t: {{ $labels.name }}."
      action: "{{ if eq $labels.platform \"windows\" }}Windows: Ressourcenmonitor unter Datentr\xE4ger pr\xFCfen. Warteschlange\
        \ mit Antwortzeiten, Durchsatz, Batch-Jobs und Storage-Last abgleichen.{{ else if eq $labels.platform \"linux\" }}Linux:\
        \ iostat -xz 1 5. Warteschlange mit Antwortzeiten, Durchsatz, Batch-Jobs und Storage-Last abgleichen.{{ else }}Betriebssystem\
        \ des \xFCberwachten Hosts pr\xFCfen. Warteschlange mit Antwortzeiten, Durchsatz, Batch-Jobs und Storage-Last abgleichen.{{\
        \ end }}"
      pending_for: 15m
      resolved_action: "Die Alarmbedingung ist nicht mehr erf\xFCllt. Aktuelle Messwerte und den betroffenen Dienst pr\xFC\
        fen; eine vollst\xE4ndige Anwendungspr\xFCfung wird durch diese Entwarnung nicht best\xE4tigt."
- name: lpm_alerts_network
  rules:
  - alert: LPMNetErrInHigh_WARN
    expr: lpm:net_err_in:rate5m{lpm_neterr_criticality="high"} > 0
    for: 5m
    labels:
      severity: WARN
      category: neterr
      lpm: high
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance
        }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMNetErrInHigh
    annotations:
      summary: Empfangsfehler an {{ $labels.interface }} auf {{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname
        }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}
      description: "Gemessene Rate (5-Minuten-Mittel): {{ $value | printf \"%.2f\" }} Fehler/s. Alarmgrenze: \xFCber 0 Fehler/s,\
        \ mindestens 5 Minuten."
      action: "{{ if eq $labels.platform \"windows\" }}Windows: Get-NetAdapterStatistics. Betroffenen Adapter anhand des Alarm-Interfaces\
        \ {{ $labels.interface }} zuordnen. Z\xE4hleranstieg mit Switchport, Linkzustand und Treiberprotokoll abgleichen.{{\
        \ else if eq $labels.platform \"linux\" }}Linux: ip -s link show \"{{ $labels.interface }}\"; ethtool -S \"{{ $labels.interface\
