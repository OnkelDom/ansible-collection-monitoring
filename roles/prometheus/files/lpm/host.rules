  - alert: LPMDiskInodesHigh_ERROR
    expr: |
      lpm:disk_inodes_used_percent:avg15m{lpm_dsk_criticality="high"} > 85
    for: 15m
    labels:
      severity: ERROR
      category: disk
      lpm: high
      hostname: '{{ if $labels.host }}{{ $labels.host }}{{ else if $labels.hostname }}{{ $labels.hostname }}{{ else }}{{ $labels.instance }}{{ end }}'
      monitoring_profile: lpm
      alert_family: LPMDiskInodesHigh
    annotations:
