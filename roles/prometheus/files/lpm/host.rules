- name: lpm_collection_health
  rules:
  - alert: LPMCollectorDown_ERROR
    expr: up{monitoring_profile="lpm"} == 0
    for: 5m
    labels:
      severity: ERROR
      category: availability
      monitoring_profile: lpm
      alert_family: LPMCollectorDown
    annotations:
      summary: Host-Metriken werden nicht eingesammelt
      description: "Der markierte Host-Scrape ist seit mindestens 5 Minuten nicht erfolgreich. Der Zustand des \xFCberwachten\
        \ Hosts ist unbekannt."
      impact: "Ressourcenalarme k\xF6nnen w\xE4hrend der Messl\xFCcke ausbleiben."
      action: "Exporter-/Alloy-Dienst, Zieladresse, Port, TLS und Firewall vom Collector aus pr\xFCfen."
      pending_for: 5m
