#jinja2: trim_blocks: True, lstrip_blocks: True
{{ ansible_managed | comment }}

global:
  resolve_timeout: {{ alertmanager_resolve_timeout | quote}}
{% for key, value in alertmanager_smtp.items() %}
  smtp_{{ key }}: {{ value | to_json }}
{% endfor %}

time_intervals:
{{ alertmanager_time_intervals | to_nice_yaml(indent=2,sort_keys=False) | indent(2, True) }}
{% set effective_inhibits = (alertmanager_lpm_inhibit_rules | default([]) if alertmanager_lpm_enabled | default(true) else []) + alertmanager_inhibit_rules + (alertmanager_proxmox_inhibit_rules | default([]) if alertmanager_proxmox_enabled is defined and alertmanager_proxmox_enabled else []) %}
{% if effective_inhibits | length > 0 %}
inhibit_rules:
{{ effective_inhibits | to_nice_yaml(indent=2,sort_keys=False) | indent(2, True) }}
{% endif %}
templates:
- '{{ alertmanager_config_dir }}/templates/*.tmpl'

receivers:
- name: blackhole
{# STANDARD RECEIVERS #}
{% set receivers = alertmanager_routes | degit.monitoring.monitoring_email_routes(alertmanager_lpm_enabled | default(true)) | selectattr('config','defined') %}{% for receiver in receivers %}
- name: {{ receiver.receiver }}
{{ receiver.config | to_nice_yaml(indent=2,sort_keys=False) | indent(2, True) }}
{%- endfor %}
{# GLOBAL TICKET #}
{% set receivers = alertmanager_routes | selectattr('global_config','defined') -%}
{% for receiver in receivers %}
- name: {{ receiver.receiver }}
  webhook_configs:
  - url: http://localhost:9099/alert
    send_resolved: true
{% endfor %}

route:
{{ alertmanager_route | to_nice_yaml(indent=2,sort_keys=False) | indent(2, True) }}
  routes:
  {% set receivers = alertmanager_routes | selectattr('routes','defined') %}{% for receiver in receivers %}{% for route in receiver.routes %}
  - receiver: {{ receiver.receiver }}
    {{ route | to_nice_yaml(indent=2, sort_keys=False) | indent(4, False) }}
  {%- endfor %}{%- endfor %}
