<tr><td style="padding:20px 24px;background:#102b3f;color:#ffffff;"><b style="font-size:22px;letter-spacing:1px;">MONITORING</b><span style="font-size:12px;letter-spacing:1px;">&nbsp;&nbsp; BETRIEBSMONITORING</span></td></tr>
<tr><td style="padding:24px;border-top:5px solid {{ if eq .Status "resolved" }}#16815d{{ else if match "(?i)^(critical|error|fatal)$" .CommonLabels.severity }}#c52b37{{ else }}#bc7509{{ end }};">
<p style="margin:0 0 10px;font-size:12px;font-weight:bold;letter-spacing:1px;color:{{ if eq .Status "resolved" }}#16815d{{ else if match "(?i)^(critical|error|fatal)$" .CommonLabels.severity }}#b3222e{{ else }}#8c5505{{ end }};">{{ if eq .Status "resolved" }}ENTWARNUNG{{ else }}{{ template "monitoring.priority" .CommonLabels.severity }} · HANDLUNGSBEDARF{{ end }}</p>
