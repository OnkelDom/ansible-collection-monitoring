<p style="margin:0 0 16px;line-height:1.6;color:#435767;">{{ if eq .Status "resolved" }}Die gemeldete Alarmbedingung ist nicht mehr aktiv.{{ else }}{{ len .Alerts.Firing }} aktive Meldung(en){{ if .Alerts.Resolved }} · {{ len .Alerts.Resolved }} inzwischen beendet{{ end }}{{ end }}</p>
<p style="margin:0;font-size:13px;color:#526678;"><b>Zuständigkeit: {{ if .CommonLabels.owner }}{{ .CommonLabels.owner }}{{ else }}Zuständiger Systembetrieb{{ end }}
</td></tr>
{{ range .Alerts }}
<tr><td style="padding:0 24px 20px;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border:1px solid #d7e0e7;border-collapse:collapse;">
<tr><td style="padding:16px 18px;background:#f5f8fa;border-bottom:1px solid #d7e0e7;">
<p style="margin:0 0 6px;font-size:11px;font-weight:bold;letter-spacing:1px;color:{{ if eq .Status "resolved" }}#16815d{{ else }}#b3222e{{ end }};">{{ if eq .Status "resolved" }}ALARM BEENDET{{ else }}AKTIV{{ end }}</p>
<h2 style="margin:0;font-size:18px;line-height:1.4;overflow-wrap:anywhere;">{{ template "monitoring.resource" .Labels }}</h2>
{{ if .Annotations.summary }}<p style="margin:6px 0 0;font-size:14px;line-height:1.5;">{{ .Annotations.summary }}</p>{{ end }}
</td></tr>
<tr><td style="padding:16px 18px;font-size:14px;line-height:1.65;">
<p style="margin:0 0 12px;color:#526678;font-size:12px;">
<b>Beginn:</b> {{ .StartsAt.UTC.Format "02.01.2006 15:04:05 MST" }}<br>
{{ if eq .Status "resolved" }}<b>Normalzustand seit:</b> {{ .EndsAt.UTC.Format "02.01.2006 15:04:05 MST" }}<br>{{ else if .Annotations.pending_for }}<b>Auslösung nach anhaltender Bedingung:</b> {{ .Annotations.pending_for }}<br>{{ end }}
{{ if .Labels.source }}<b>Quelle:</b> {{ .Labels.source }}<br>{{ end }}{{ if .Labels.site_name }}<b>Standort:</b> {{ .Labels.site_name }}<br>{{ end }}
{{ if .Labels.essid }}<b>WLAN:</b> {{ .Labels.essid }}<br>{{ end }}{{ if .Labels.path }}<b>Pfad:</b> {{ .Labels.path }}<br>{{ end }}{{ if .Labels.interface }}<b>Interface:</b> {{ .Labels.interface }}<br>{{ end }}
{{ if .Labels.database }}<b>Datenbank:</b> {{ .Labels.database }}<br>{{ end }}{{ if .Labels.datname }}<b>Datenbank:</b> {{ .Labels.datname }}<br>{{ end }}{{ if .Labels.storage }}<b>Storage:</b> {{ .Labels.storage }}<br>{{ end }}{{ if .Labels.task }}<b>Aufgabe:</b> {{ .Labels.task }}<br>{{ end }}{{ if .Labels.service }}<b>Dienst:</b> {{ .Labels.service }}<br>{{ end }}{{ if .Labels.threshold }}<b>Schwelle:</b> {{ .Labels.threshold }}{{ end }}
