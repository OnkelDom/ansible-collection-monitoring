+func blocklistDomainCount(stream io.Reader) (int, error) {
+	domains := make(map[string]struct{})
+	pattern := regexp.MustCompile(`^\s*(?:local-zone|local-data):\s*"?([^"\s]+)`)
+	scanner := bufio.NewScanner(stream)
+	scanner.Buffer(make([]byte, 1024), 1024*1024)
+	for scanner.Scan() {
+		match := pattern.FindStringSubmatch(scanner.Text())
+		if len(match) == 2 {
+			domains[strings.ToLower(strings.TrimSuffix(match[1], "."))] = struct{}{}
+		}
+	}
+	return len(domains), scanner.Err()
+}
 
