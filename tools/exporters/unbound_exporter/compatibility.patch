@@ -0,0 +1,25 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestBlocklistDomainCount(t *testing.T) {
+	cases := []struct {
+		input string
+		want  int
+	}{
+		{"", 0},
+		{"# header\n\n", 0},
+		{`local-zone: "one.invalid" always_nxdomain`, 1},
+		{"# header\nlocal-zone: \"one.invalid.\" static\nlocal-data: \"ONE.invalid A 0.0.0.0\"\n", 1},
+		{"local-data: \"one.invalid A 0.0.0.0\"\nlocal-data: \"one.invalid AAAA ::\"\nlocal-zone: \"two.invalid\" always_nxdomain\n", 2},
+	}
+	for _, c := range cases {
+		got, err := blocklistDomainCount(strings.NewReader(c.input))
+		if err != nil || got != c.want {
+			t.Fatalf("got %d, %v; want %d", got, err, c.want)
+		}
+	}
+}
