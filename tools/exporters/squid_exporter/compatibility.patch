+++ collector/manager_path_test.go
@@ -0,0 +1,24 @@
+package collector
+
+import (
+    "fmt"
+    "net"
+    "net/http"
+    "testing"
+)
+
+func TestModernManagerPath(t *testing.T) {
+    listener, err := net.Listen("tcp", "127.0.0.1:0")
+    if err != nil { t.Fatal(err) }
+    defer listener.Close()
+    server := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+        if r.URL.Path != "/squid-internal-mgr/counters" { t.Errorf("unexpected manager path: %s", r.URL.Path); w.WriteHeader(400); return }
+        fmt.Fprintln(w, "client_http.requests = 42")
+    })}
+    defer server.Close()
+    go server.Serve(listener)
+    client := NewCacheObjectClient("127.0.0.1", listener.Addr().(*net.TCPAddr).Port, "", "")
+    counters, err := client.GetCounters()
+    if err != nil { t.Fatal(err) }
+    if len(counters) != 1 { t.Fatalf("expected one real parsed counter, got %v", counters) }
+}
